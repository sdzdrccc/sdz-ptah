  "fallback_policy": {
    "default": "fail",
    "text2img": "只有 generation.text2img_consent=true 才放行，manifest 记 identity_unverified=true",
    "exit_code": 4,
    "cross_backend": "禁止自动换后端；换后端必须改 brief.generation.stages 并重新走确认门"
  },
