# TRAE 本地工作区配置，不入库
.trae/

# 本地截图与临时缓存
.screenshots/
__pycache__/
*.pyc

# WorkBuddy 工作日志与项目记忆（不入库）
.workbuddy/

# 运行时订单数据：含生成图与逐单台账，运行时产生，不入库
orders/

# 本地上传缓存：网页控制台的参考图上传，运行时产生，不入库
app/uploads/

# 运行时生成的用户自定义角色/风格档案
app/custom/

# 临时安全网备份：变更前的 .bak 快照，不入库
*.bak-*

# 本地校准基准图：现成动漫作品角色图，仅作阈值校准，不进公开仓库
design/baselines/

# 生成的验证输出：体积大（单轮约 35 MB）且可由 avatar_pipeline.py 完整复现
# 统一命名 out-<变体>，见 CONVENTIONS.md
design/verify/out-*/

# 生成图与测试图：本地保留，不入库。
# 理由：这些图是版权角色的衍生形象，公开仓库分发会触及原权利人的复制/改编权，
# 与是否商用无关（2026-11-26 决定：代码开源，图不入库）。
# 因此 design/verify/*/manifest.json 里的图片路径是本地历史记录，克隆后没有对应文件。
design/verify/raw/
design/verify/control/
design/probe/*.jpg
design/probe/*.png

# 密钥与本机覆盖配置
.env
*.local.json
app/secrets.local.json

# 临时提交信息文件
.git-commit-msg.tmp
